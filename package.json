{
  "name": "status-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"vite\" \"node --watch server/local-api.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/local-api.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/production.mjs",
    "preview": "vite preview",
    "test:api": "node --test server/openai-core.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "firebase": "^10.14.1",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
