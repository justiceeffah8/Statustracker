rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /artifacts/{appId}/users/{userId}/profile/{profileId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /artifacts/{appId}/public/data/courses/{courseId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.instructorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.instructorId == request.auth.uid;
    }

    match /artifacts/{appId}/public/data/enrollments/{enrollmentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.studentId == request.auth.uid;
    }

    match /artifacts/{appId}/public/data/mastery/{masteryId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.studentId == request.auth.uid;
    }

    match /artifacts/{appId}/public/data/usage/{usageId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow delete: if signedIn() && resource.data.studentId == request.auth.uid;
    }

    match /artifacts/{appId}/public/data/progressReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.studentId == request.auth.uid;
    }

    match /artifacts/{appId}/public/data/usernames/{usernameId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
